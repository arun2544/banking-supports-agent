# Groq LLM configuration
GROQ_API_KEY=your-groq-api-key-here
MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Authentication
# Generate a secure secret using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-secure-random-secret
JWT_TTL_MIN=30

# Rate limiting
RATE_LIMIT_PER_MIN=30

# Optional self-hosted LLM (OpenAI-compatible API)
SELF_HOSTED_URL=
SELF_HOSTED_MODEL=llama3.1
SELF_HOSTED_API_KEY=

# Cost tracker prices (USD per 1 million tokens)
# Update these according to your actual model/provider pricing
THIRD_PARTY_PRICE_IN_PER_M=3.0
THIRD_PARTY_PRICE_OUT_PER_M=15.0
SELF_HOSTED_PRICE_IN_PER_M=0.0
SELF_HOSTED_PRICE_OUT_PER_M=0.0
